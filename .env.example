# Copy this to .env and fill in real values.
# .env itself must be in .gitignore — only this .example file should be committed.

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
ALGORITHM_VERSION=rules-v1

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustops
DB_USER=trustops
DB_PASSWORD=trustops_pass

# --- GitHub App ---
GITHUB_APP_APP_ID=123456
GITHUB_APP_WEBHOOK_SECRET=changeme
# Path to the .pem file, not the raw key
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem

# --- Queue ---
QUEUE_BACKEND=postgres
# If backend is "sqs", you must also set:
# QUEUE_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/my-queue

# --- Feature Flags ---
FEATURE_IDE_PLUGIN_SOURCE_ENABLED=false
FEATURE_ENFORCE_EVIDENCE_COMPLETENESS=true
